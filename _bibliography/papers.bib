@article{carter2025cropland,
  bibtex_show={true},
  abbr={Ecol. Ind.},
  title={Annual cultivated extent and agricultural land use expansion across the central grasslands of North America, 1996--2021},
  author={Carter, Sean and Morford, Scott L. and Tack, Jason D. and Lark, Tyler J. and Uludere Aragon, Nazli and Allred, Brady W. and Twidwell, Dirac and Naugle, David E.},
  journal={Ecological Indicators},
  volume={178},
  pages={113968},
  year={2025},
  publisher={Elsevier},
  doi={10.1016/j.ecolind.2025.113968},
  pdf={annual_cropland_extent.pdf},
  abstract={We developed a 30-meter resolution dataset capturing annual 'active' and 'cumulative' cropland (1996 to 2021) across the central grasslands of North America using an Attention U-Net convolutional neural network. Our bias-corrected estimates reveal that while active cropland showed no significant change, the cumulative cropland footprint expanded by 17% relative to the baseline (1996--2000), reaching 142.21 million ha by 2021. This divergence indicates substantial new conversion or recultivation of previously restored grasslands, occurring at a consistent rate of 0.98 million ha per year.},
  html={https://doi.org/10.1016/j.ecolind.2025.113968},
  selected={true},
  code={https://github.com/COYE-Coder/Annual-Cropland-Extent},
  website={https://wlfw-um.projects.earthengine.app/view/cropland-extent-map}
}

@article{carter2021ais,
  bibtex_show={true},
  abbr={Front. Big Data},
  title={Testing a Generalizable Machine Learning Workflow for Aquatic Invasive Species on Rainbow Trout (\textit{Oncorhynchus mykiss}) in Northwest Montana},
  author={Carter, Sean and van Rees, Charles B. and Hand, Brian K. and Muhlfeld, Clint C. and Luikart, Gordon and Kimball, John S.},
  journal={Frontiers in Big Data},
  volume={4},
  pages={734990},
  year={2021},
  doi={10.3389/fdata.2021.734990},
  pdf={aquatic_invasive_species.pdf},
  abstract={We present a workflow that generates rapid spatial risk assessments on aquatic invasive species using occurrence data, spatially explicit environmental data, and an ensemble approach to species distribution modeling using five machine learning algorithms. We tested this workflow on Rainbow Trout (Oncorhynchus mykiss) invasion in the upper Flathead River system in northwestern Montana. The ensemble modeling technique yielded high accuracy predictions relative to 30-fold cross-validated datasets (87\% accuracy score).},
  html={https://doi.org/10.3389/fdata.2021.734990},
  selected={true}
}

